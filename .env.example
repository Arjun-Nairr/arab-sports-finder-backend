# Copy to .env (ignored). Never commit real values.
# Required: Neon PostgreSQL connection string.
DATABASE_URL=
# Optional: Ajel Wire API key (free account at https://wire.ajel.sa/wire/en/register).
# Without it the Wire API is not attempted; the keyless Ajel AI feed is still used.
AJEL_WIRE_API_KEY=

# T04: free Groq key (https://console.groq.com/keys). Model is checked against the account's /models list.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Finite limits (defaults shown).
SCREEN_CANDIDATES=20
REPRESENTATION_SEARCHES=3
GROQ_MAX_CALLS=8
GROQ_MAX_TOKENS=2000
GROQ_RETRIES=1
MAX_REVISIONS=2
WIKIDATA_PER_NATION=2
WIKIDATA_MAX_NATIONS=22
WIKIDATA_MAX_PAGES=3
WIKIDATA_REFRESH=10
GDELT_ENABLED=1
GROQ_TPM=8000
GROQ_RPM=30
GROQ_MAX_WAIT_S=480
AJEL_MAX_ARTICLES=10
# Wire name searches per run (rotating through athletes not yet searched) and full articles fetched.
AJEL_NAME_SEARCHES=10
AJEL_WIRE_ARTICLES=10
GDELT_MAX_RECORDS=25
GDELT_NAME_QUERIES=3
THESPORTSDB_LOOKUPS=3
# Stored-article recheck for new/changed identities, per run; the rest resumes next run.
RECHECK_IDENTITIES=50
RECHECK_ARTICLES=200
HTTP_TIMEOUT_S=30
HTTP_RETRIES=2
# English Wikipedia biographies (background evidence): athletes per run, re-checks, request cap, retries per request.
WIKIPEDIA_BIOGRAPHIES=10
WIKIPEDIA_REFRESH=10
WIKIPEDIA_MAX_REQUESTS=12
WIKIPEDIA_RETRIES=1
# Optional operator contact (URL or email) appended to the Wikimedia User-Agent, as their UA policy asks.
WIKIMEDIA_CONTACT=
